HOST=127.0.0.1
PORT=8932
APP_DATA_DIR=./.runtime
PUBLIC_ORIGIN=http://127.0.0.1:8932
# Set an exact owner email only behind the trusted Launchpad gateway.
LAUNCHER_OWNER_EMAIL=
CODEX_BIN=codex
CLAUDE_BIN=claude
# Optional private file produced from the official `claude setup-token` flow.
CLAUDE_OAUTH_TOKEN_FILE=
CHATGPT_MODEL=gpt-6.1-sol
CLAUDE_MODEL=sonnet

# Optional repository-review sandbox; leave unset until live acceptance passes.
REVIEW_IMAGE_DIGEST=
DOCKER_BIN=docker
# Existing legacy CI key remains independent during both client migrations.
CI_REVIEW_KEY_FILE=
